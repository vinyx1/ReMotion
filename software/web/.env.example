# Copy this file to .env (same folder) and fill in the key.
# .env is git-ignored; never commit a real key.
#
# Used only by the dev/preview server for the dashboard's "Generate summary" button
# (server/summary.ts). It is not sent to the browser.
# Get a key at https://console.anthropic.com/ (Settings -> API keys).
ANTHROPIC_API_KEY=
