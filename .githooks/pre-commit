#!/bin/sh
# Refuses a commit that adds an API key, a password or a key file (software/tools/check_secrets.py).
# Turn it on once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
for py in .venv/bin/python python3 python; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then
    exec "$py" -m software.tools.check_secrets --staged
  fi
done
echo "Secret check skipped: no Python found." >&2
